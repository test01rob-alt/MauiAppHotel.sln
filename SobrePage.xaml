<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.SobrePage"
             Title="Sobre o Desenvolvedor"
             BackgroundColor="#1E3A5F">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="DADOS DO DESENVOLVEDOR" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />

        <BoxView HeightRequest="2" BackgroundColor="Black" />

        <Label Text="Nome: Robson" FontSize="18" TextColor="White" />
        <Label Text="Ano: 2026" FontSize="18" TextColor="White" />
        <Label Text="Instituição: ETEC Centro Paula Souza" FontSize="18" TextColor="White" />
        <Label Text="Projeto: App Hotel - Agenda 13" FontSize="18" TextColor="White" />

        <BoxView HeightRequest="2" BackgroundColor="Black" />

        <Label Text="Desenvolvido em .NET MAUI" FontSize="14" TextColor="#B0C4DE" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>