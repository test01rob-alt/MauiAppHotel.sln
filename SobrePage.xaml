<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.SobrePage"
             Title="Sobre o Desenvolvedor"
             BackgroundColor="#0F0F14">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">

        <!-- Avatar Premium -->
        <Border Stroke="#D4AF37" StrokeThickness="2" StrokeShape="RoundRectangle 60" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center">
            <Label Text="👨‍💻" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <Label Text="DADOS DO DESENVOLVEDOR" FontSize="20" FontAttributes="Bold" TextColor="#D4AF37" HorizontalOptions="Center" CharacterSpacing="1" />

        <!-- Card de Informações Integrado ao Tema Black & Gold -->
        <Border Stroke="#333344" StrokeShape="RoundRectangle 12" BackgroundColor="#1A1A22" Padding="20" WidthRequest="320">
            <VerticalStackLayout Spacing="14">

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Nome:" FontAttributes="Bold" TextColor="#A6A6A6" WidthRequest="90"/>
                    <Label Text="Robson" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#333344" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Ano:" FontAttributes="Bold" TextColor="#A6A6A6" WidthRequest="90"/>
                    <Label Text="2026" TextColor="White" FontSize="16"/>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#333344" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Instituição:" FontAttributes="Bold" TextColor="#A6A6A6" WidthRequest="90"/>
                    <Label Text="ETEC Centro Paula Souza" TextColor="White" FontSize="14" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#333344" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Projeto:" FontAttributes="Bold" TextColor="#A6A6A6" WidthRequest="90"/>
                    <Label Text="App Hotel - Agenda 13" TextColor="White" FontSize="14" VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Label Text="Desenvolvido em .NET MAUI" FontSize="13" TextColor="#666666" HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>